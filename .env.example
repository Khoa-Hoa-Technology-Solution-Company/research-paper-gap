# LLM Configuration
LLM_PROVIDER=openai # openai hoặc groq
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini # openai: gpt-4o-mini, gpt-4o | groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
LLM_BASE_URL= # Để trống để dùng mặc định, hoặc điền URL nếu dùng proxy / local LLM
LLM_DELAY=0.1
# Optional forward-provenance fields. Leave unknown provider values blank;
# do not infer a model revision/date from the model name.
LLM_MODEL_REVISION=
LLM_MODEL_RELEASE_DATE=
LLM_API_VERSION=
LLM_API_DATE=
LLM_TOP_P=
LLM_MAX_RETRIES=7
LLM_RETRY_BASE_DELAY_SECONDS=5.0
LLM_RETRY_NON_RATE_LIMIT_DELAY_SECONDS=3.0
# hash-only (default), store (only when approved), or none.
LLM_RAW_RESPONSE_POLICY=hash-only
# Semantic Scholar Configuration (Optional, for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_API_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_REQUEST_TIMEOUT_SECONDS=30
SEMANTIC_SCHOLAR_REQUEST_DELAY_SECONDS=3.0

# Optional isolated experiment ID. Leave empty for legacy data/ artifacts.
# Example: KG_TABI_RUN_ID=microservices-security-v1
KG_TABI_RUN_ID=
